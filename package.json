{
  "name": "belong",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "oxlint --fix",
    "format": "turbo format",
    "format:check": "oxfmt --check 'apps/*/src/**' 'packages/*/src/**' '!apps/web/src/routeTree.gen.ts'",
    "typecheck": "turbo typecheck",
    "docker:build": "turbo docker:build",
    "docker:push": "turbo docker:push",
    "docker:up": "docker compose -f docker-compose.yml up -d",
    "docker:down": "docker compose -f docker-compose.yml down"
  },
  "devDependencies": {
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.11"
}
