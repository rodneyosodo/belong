{
  "name": "belong",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "oxlint --fix",
    "format": "turbo format",
    "format:check": "oxfmt --check 'apps/*/src/**' 'packages/*/src/**' '!apps/web/src/routeTree.gen.ts'",
    "typecheck": "turbo typecheck",
    "docker:build": "turbo docker:build",
    "docker:push": "turbo docker:push",
    "docker:build:release": "TAG=$(node -p \"require('./package.json').version\") turbo docker:build",
    "docker:push:release": "TAG=$(node -p \"require('./package.json').version\") turbo docker:push",
    "docker:up": "docker compose -f docker-compose.yml --env-file .env up -d",
    "docker:down": "docker compose -f docker-compose.yml --env-file .env down",
    "docker:backend:start": "docker compose -f apps/backend/compose-dev.yaml --env-file apps/backend/.env up -d",
    "docker:backend:stop": "docker compose -f apps/backend/compose-dev.yaml --env-file apps/backend/.env down"
  },
  "devDependencies": {
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "turbo": "^2.10.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.11"
}
